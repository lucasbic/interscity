---

# General
rails_env: production
secret_key_base: 'admin'

enabled_db_backups: false

# Ports
resource_cataloguer_port: 3000
resource_adaptor_port: 3001
data_collector_port: 3002
actuator_controller_port: 3003
resource_discoverer_port: 3004
kong_port: 8000
kong_admin_port: 8001
mongo_port: 27017

# Docker
resource_cataloguer_docker_image: registry.gitlab.com/interscity/interscity-platform/interscity-platform/resource-cataloguer:latest
resource_adaptor_docker_image: registry.gitlab.com/interscity/interscity-platform/interscity-platform/resource-adaptor:latest
data_collector_docker_image: interscity/data-collector-sqs:latest
actuator_controller_docker_image: registry.gitlab.com/interscity/interscity-platform/interscity-platform/actuator-controller:latest
resource_discoverer_docker_image: registry.gitlab.com/interscity/interscity-platform/interscity-platform/resource-discoverer:latest
kong_api_gateway_docker_image: registry.gitlab.com/interscity/interscity-platform/interscity-platform/kong-api-gateway:latest

# Postgresql
postgres_image: 'postgres:9.5'
postgres_port: 5432
postgres_user: 'postgres'
postgres_password: 'admin'
postgres_kong_user: 'kong'
postgres_kong_password: 'kongpass'
postgres_rescat_user: 'resource_cataloguer'
postgres_rescat_password: 'rescatpass'
postgres_resadapt_user: 'resource_adaptor'
postgres_resadapt_password: 'resadaptpass'

# Mongo
mongo_user: 'admin'
mongo_password: 'admin'
replica_set_name: 'interscity-set'
mongodb_image: 'mongo:3.6'

# Collectl
collecting_time: 1m
collecting_interval: 5

# Swarm
swarm_deployments_path: /opt/docker-swarm-deployments

# Kong
kong_image: 'kong:0.11.0'
kong_database: 'postgres'

# SQS
aws_access_key_id: '{{ aws_access_key }}'
aws_secret_access_key: '{{ aws_secret_key }}'
sqs_queue_url: '{{ sqs_queue_url }}'

# Redis
redis_image: 'redis:5.0.2'
